    "trees": 200,
    "search_trees": 60,
    "n_trials": 6
  },
  "recency_half_life_weeks": "13",
  "input_files": "model_ready_{fit,valid}.parquet (notebook 05: imputed, scaled, one-hot)",
  "excluded_from_features": [
    "case_id",
    "target",
    "WEEK_NUM",
    "thin_file"
  ]
}