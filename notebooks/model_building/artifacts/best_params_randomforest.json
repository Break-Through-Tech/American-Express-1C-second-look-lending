{
  "split": {
    "train_weeks": "0-67",
    "tune_weeks": "68-79",
    "valid_weeks": "80-91",
    "final_fit_weeks": "0-79"
  },
  "selection": "lowest tune LogLoss; ties within 0.0003 broken by largest min_samples_leaf",
  "randomforest": {
    "params": {
      "min_samples_leaf": 258,
      "max_features": 0.3,
      "max_depth": 14,
      "max_samples": 0.35
